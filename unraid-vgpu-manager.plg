<?xml version="1.0" standalone="yes"?>
<PLUGIN name="unraid-vgpu-manager" author="unraid-vgpu-manager contributors" version="2026.11.17.1" launch="Settings/unraid-vgpu-manager" min="7.0.0" pluginURL="https://raw.githubusercontent.com/ManuZhu0728/unraid-vgpu-plugin/main/unraid-vgpu-manager.plg">
<CHANGES>
Use Unraid native driver installation; the plugin verifies it before vGPU initialization.
Separate multi-build caches from one selected native boot package per kernel.
Require explicit boot selection after downloads or local imports; preserve other builds.
Verify pkgtools build/source, checksums, module fingerprints and loaded module identity.
Keep existing plugin entrypoints and GPU usage protection; add no system startup hooks.
Test native startup ordering, build switching, migration, initialization and WebGUI regressions.
</CHANGES>
<FILE Name="/boot/config/plugins/unraid-vgpu-manager/unraid-vgpu-manager-2026.11.17.1-noarch-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/ManuZhu0728/unraid-vgpu-plugin/releases/download/v2026.11.17.1-alpha.18/unraid-vgpu-manager-2026.11.17.1-noarch-1.txz</URL>
<MD5>61e9dc856f62c603f8b942f642c75225</MD5>
</FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
# Installation must succeed without a repository, token or NVIDIA package.
# The new plugin must not take ownership of an existing GPU stack implicitly.
if ! /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/rc.vgpu boot </dev/null; then
  echo "unraid-vgpu-manager: UI installed; runtime needs configuration or maintenance. Existing services were not taken over."
fi
/bin/bash /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/upgrade-helper start
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
# Do not kill GPU clients, undefine mdevs or remove driver packages on uninstall.
# Withdraw only our native boot copies before removing our own backend files.
if [ -f /usr/local/emhttp/plugins/unraid-vgpu-manager/include/cli.php ]; then
  if ! printf '%s\n' '{"driver":{"enabled":false}}' | /usr/bin/php /usr/local/emhttp/plugins/unraid-vgpu-manager/include/cli.php config-save; then
    echo "Cannot withdraw the plugin native boot selection; plugin files were retained. No GPU service was stopped."
    exit 1
  fi
fi
if [ -f /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/upgrade-helper ]; then
  /bin/bash /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/upgrade-helper stop
fi
if pgrep -x nvidia-vgpu-mgr >/dev/null 2>&1; then
  echo "The NVIDIA manager remains running. Plan a maintenance reboot before using another runtime owner."
fi
removepkg unraid-vgpu-manager
echo "Boot restoration disabled; credentials, device definitions and cached drivers were retained."
]]></INLINE></FILE>
</PLUGIN>
