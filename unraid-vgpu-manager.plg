<?xml version="1.0" standalone="yes"?>
<PLUGIN name="unraid-vgpu-manager" author="unraid-vgpu-manager contributors" version="2026.11.02.3" launch="Settings/unraid-vgpu-manager" min="7.0.0" pluginURL="https://raw.githubusercontent.com/ManuZhu0728/unraid-vgpu-plugin/main/unraid-vgpu-manager.plg">
<CHANGES>
Public plugin UI with configurable GitHub/GitLab driver sources.
Driver downloads only populate a verified cache. No hot driver installation.
Runtime management defaults OFF. Migrate old startup owners before enabling it.
</CHANGES>
<FILE Name="/boot/config/plugins/unraid-vgpu-manager/unraid-vgpu-manager-2026.11.02.3-noarch-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/ManuZhu0728/unraid-vgpu-plugin/releases/download/v2026.11.02.3-alpha.1/unraid-vgpu-manager-2026.11.02.3-noarch-1.txz</URL>
<MD5>05a0e331681e41131228cfd92b40370d</MD5>
</FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
# Installation must succeed without a repository, token or NVIDIA package.
# The new plugin must not take ownership of an existing GPU stack implicitly.
if ! /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/rc.vgpu boot </dev/null; then
  echo "unraid-vgpu-manager: UI installed; runtime needs configuration or maintenance. Existing services were not taken over."
fi
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
# Do not kill GPU clients, undefine mdevs or remove driver packages on uninstall.
if pgrep -x nvidia-vgpu-mgr >/dev/null 2>&1; then
  echo "The NVIDIA manager remains running. Plan a maintenance reboot before using another runtime owner."
fi
removepkg unraid-vgpu-manager
echo "Persistent settings, credentials, device definitions and cached drivers were retained."
]]></INLINE></FILE>
</PLUGIN>
