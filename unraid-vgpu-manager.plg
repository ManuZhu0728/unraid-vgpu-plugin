<?xml version="1.0" standalone="yes"?>
<PLUGIN name="unraid-vgpu-manager" author="unraid-vgpu-manager contributors" version="2026.11.16.5" launch="Settings/unraid-vgpu-manager" min="7.0.0" pluginURL="https://raw.githubusercontent.com/ManuZhu0728/unraid-vgpu-plugin/main/unraid-vgpu-manager.plg">
<CHANGES>
Fix binary chunk uploads stalling in the native nginx/PHP authentication gateway.
Encode bounded binary chunks in ordinary URL-encoded forms, including cancellation.
Require an independent MD5 file for local imports and verify it before selecting cache.
Preserve old caches and prevent retries when upload or cancellation results are unknown.
Verify upload, cancellation and failures through a real local browser/nginx/PHP-FPM chain.
Audit UI typography without changing fonts, driver installation, startup or GPU runtime.
</CHANGES>
<FILE Name="/boot/config/plugins/unraid-vgpu-manager/unraid-vgpu-manager-2026.11.16.5-noarch-1.txz" Run="upgradepkg --install-new --reinstall">
<URL>https://github.com/ManuZhu0728/unraid-vgpu-plugin/releases/download/v2026.11.16.5-alpha.16/unraid-vgpu-manager-2026.11.16.5-noarch-1.txz</URL>
<MD5>a73cbc77663e509dc2344f997f82d922</MD5>
</FILE>
<FILE Run="/bin/bash"><INLINE><![CDATA[
# Installation must succeed without a repository, token or NVIDIA package.
# The new plugin must not take ownership of an existing GPU stack implicitly.
if ! /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/rc.vgpu boot </dev/null; then
  echo "unraid-vgpu-manager: UI installed; runtime needs configuration or maintenance. Existing services were not taken over."
fi
/bin/bash /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/upgrade-helper start
]]></INLINE></FILE>
<FILE Run="/bin/bash" Method="remove"><INLINE><![CDATA[
# Do not kill GPU clients, undefine mdevs or remove driver packages on uninstall.
if [ -f /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/upgrade-helper ]; then
  /bin/bash /usr/local/emhttp/plugins/unraid-vgpu-manager/scripts/upgrade-helper stop
fi
if pgrep -x nvidia-vgpu-mgr >/dev/null 2>&1; then
  echo "The NVIDIA manager remains running. Plan a maintenance reboot before using another runtime owner."
fi
removepkg unraid-vgpu-manager
echo "Persistent settings, credentials, device definitions and cached drivers were retained."
]]></INLINE></FILE>
</PLUGIN>
