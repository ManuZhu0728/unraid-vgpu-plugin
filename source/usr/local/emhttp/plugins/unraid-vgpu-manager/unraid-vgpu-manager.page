      </fieldset>
    </form>
    <p class="uvm-muted">若配置列表为空，请检查运行时状态和既有服务。不要为了刷新列表而热卸载共享中的显卡。</p>
  </section>
</div>

<script>
(function () {
  'use strict';
  const root = document.getElementById('uvm-manager');
  if (!root) return;
  const gpus = <?=uvm_json($uvm_gpus)?>;
  const notice = document.getElementById('uvm-browser-message');
  function message(text, error) {
    notice.textContent = text;
    notice.hidden = false;
    notice.className = error ? 'uvm-note uvm-error' : 'uvm-note';
  }
  const provider = document.getElementById('uvm-source-provider');
  const mode = document.getElementById('uvm-source-mode');
  function sourceOptions() {
    const generic = mode.querySelector('option[value="generic"]');
    generic.disabled = provider.value === 'github';
    if (generic.disabled && mode.value === 'generic') mode.value = 'releases';
    const credentialType = document.getElementById('uvm-credential-type');
    Array.from(credentialType.options).forEach(function (option) {
      option.disabled = provider.value === 'github' ? option.value !== 'bearer' : option.value === 'bearer';
    });
    if (credentialType.selectedOptions[0].disabled) credentialType.value = provider.value === 'github' ? 'bearer' : 'private-token';
  }
  provider.addEventListener('change', sourceOptions);
  sourceOptions();
  const credentialChange = document.getElementById('uvm-credential-change');
  function credentialOptions() {
    const replacing = credentialChange.value === 'replace';
    ['uvm-credential-type', 'uvm-credential-token', 'uvm-credential-username'].forEach(function (id) {
      document.getElementById(id).disabled = !replacing;
    });
    const token = document.getElementById('uvm-credential-token');
    token.required = replacing;
    if (!replacing) token.value = '';
  }
  credentialChange.addEventListener('change', credentialOptions);
  credentialOptions();
  const replaceOverride = document.getElementById('uvm-override-replace');
  const override = document.getElementById('uvm-override-content');
  function overrideOptions() { override.disabled = !replaceOverride.checked; }
  replaceOverride.addEventListener('change', overrideOptions);
  overrideOptions();

  const pci = document.getElementById('uvm-device-pci');
  const profile = document.getElementById('uvm-device-profile');
  const type = document.getElementById('uvm-device-type');
  const uuid = document.getElementById('uvm-device-uuid');
  const body = document.getElementById('uvm-profile-body');
  function cell(row, text) {
    const node = document.createElement('td');
    node.textContent = text;
    row.appendChild(node);
    return node;
  }
  function renderProfiles(selectedName) {
    body.replaceChildren();
    const rows = gpus[pci.value] ? gpus[pci.value].profiles : [];
    if (!rows.length) {
      const row = document.createElement('tr');
      const node = cell(row, pci.value ? '驱动尚未公布此 GPU 的 mdev 配置；请检查运行时状态。' : '选择 GPU 后显示驱动提供的配置。');
      node.colSpan = 8;
      body.appendChild(row);
      return;
    }
    rows.forEach(function (entry) {
      const row = document.createElement('tr');
      const select = document.createElement('input');
      select.type = 'radio';
      select.name = 'uvm_profile_picker';
      select.value = entry.type;
      select.setAttribute('aria-label', entry.name);
      const current = selectedName === entry.name;
      select.checked = current;
      // Existing definitions can still be viewed/edited even if their profile is full.
      select.disabled = Number(entry.available) === 0 && !current;
      if (current) row.className = 'uvm-profile-current';
      select.addEventListener('change', function () {
        profile.value = entry.name;
        type.value = entry.type;
        body.querySelectorAll('tr').forEach(function (item) { item.classList.remove('uvm-profile-current'); });
        row.classList.add('uvm-profile-current');
      });
      const selected = cell(row, '');
      selected.appendChild(select);
      [entry.name, entry.type, entry.framebuffer, entry.heads, entry.resolution, entry.frl, entry.available + ' / ' + (entry.maximum || '未知')].forEach(function (value) { cell(row, value); });
      body.appendChild(row);
      if (current) type.value = entry.type;
    });
  }
  pci.addEventListener('change', function () {
    profile.value = '';
    type.value = '';
    renderProfiles('');
  });
  root.querySelectorAll('.uvm-edit-device').forEach(function (button) {
    button.addEventListener('click', function () {
      try {
        const device = JSON.parse(button.dataset.device);
        uuid.value = device.uuid;
        if (!gpus[device.pci]) {
          const existing = Array.from(pci.options).find(function (option) { return option.value === device.pci; });
          if (!existing) {
            const option = document.createElement('option');
            option.value = device.pci;
            option.textContent = device.pci + '（当前未发现）';
            pci.appendChild(option);
          }
        }
        pci.value = device.pci;
        profile.value = device.profile;
        type.value = device.type;
        renderProfiles(device.profile);
        document.getElementById('uvm-device-form').scrollIntoView({behavior: 'smooth', block: 'center'});
      } catch (_) { message('无法读取该设备配置，请刷新页面后重试。', true); }
    });
  });
  document.getElementById('uvm-new-device').addEventListener('click', function () {
    if (!window.crypto || !window.crypto.getRandomValues) {
      message('浏览器无法安全生成 UUID，请刷新页面使用服务端生成的 UUID。', true);
      return;
    }
    const bytes = window.crypto.getRandomValues(new Uint8Array(16));
    bytes[6] = (bytes[6] & 15) | 64;
    bytes[8] = (bytes[8] & 63) | 128;
    const hex = Array.from(bytes, function (value) { return value.toString(16).padStart(2, '0'); }).join('');
    uuid.value = [hex.slice(0, 8), hex.slice(8, 12), hex.slice(12, 16), hex.slice(16, 20), hex.slice(20)].join('-');
    pci.value = '';
    profile.value = '';
    type.value = '';
    renderProfiles('');
  });
  root.querySelectorAll('.uvm-copy-xml').forEach(function (button) {
    button.addEventListener('click', async function () {
      const snippet = button.parentElement.querySelector('.uvm-vm-xml');
      try {
        if (!navigator.clipboard) throw new Error('clipboard unavailable');
        await navigator.clipboard.writeText(snippet.textContent);
        message('XML 已复制。修改 VM XML 前先关闭虚拟机并核对 UUID。', false);
      } catch (_) {
        const selection = window.getSelection();
        const range = document.createRange();
        range.selectNodeContents(snippet);
        selection.removeAllRanges();
        selection.addRange(range);
        message('浏览器未允许剪贴板访问，已选中 XML，请手动复制。', false);
      }
    });
  });
  let submitting = false;
  root.querySelectorAll('.uvm-submit-form').forEach(function (form) {
    form.addEventListener('submit', function (event) {
      if (submitting) { event.preventDefault(); return; }
      if (form.dataset.confirm && !window.confirm(form.dataset.confirm)) { event.preventDefault(); return; }
      if (form.id === 'uvm-device-form' && (!profile.value || !type.value)) {
        event.preventDefault();
        message('请先从当前 GPU 配置表选择 profile。', true);
        return;
      }
      submitting = true;
      form.classList.add('uvm-form-busy');
      // Do not disable form fields: their values must remain in the submitted POST.
      message('正在提交操作，请勿重复点击或刷新；下载可能需要数分钟。', false);
    });
  });
  renderProfiles('');
})();
</script>
