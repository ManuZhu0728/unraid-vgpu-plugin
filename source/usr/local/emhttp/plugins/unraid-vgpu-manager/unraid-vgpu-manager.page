Title="NVIDIA vGPU Manager"
Icon="nvidia-driver.png"
---
<?php
/* Public UI only. Configuration, credentials and device mutations belong to cli.php. */

function uvm_h($value): string
{
    return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function uvm_json($value): string
{
    return json_encode($value, JSON_HEX_TAG | JSON_HEX_AMP | JSON_HEX_APOS | JSON_HEX_QUOT | JSON_INVALID_UTF8_SUBSTITUTE | JSON_UNESCAPED_SLASHES);
}

function uvm_read(string $path, int $limit = 65536): string
{
    if (!is_readable($path) || !is_file($path)) return '';
    $value = @file_get_contents($path, false, null, 0, $limit);
    return $value === false ? '' : trim($value);
}

function uvm_post(string $key, string $default = ''): string
{
    if (!isset($_POST[$key])) return $default;
    if (!is_string($_POST[$key])) throw new InvalidArgumentException('Invalid form field: ' . $key);
    return $_POST[$key];
}

function uvm_upload_chunk_size(): int
{
    $limit = 1048576;
    foreach (['upload_max_filesize', 'post_max_size'] as $option) {
        $value = trim((string)ini_get($option));
        if (!preg_match('/^([0-9]+)\s*([KMG]?)$/i', $value, $match) || (int)$match[1] === 0) continue;
        $bytes = (int)$match[1] * (1024 ** (int)strpos(' KMGT', strtoupper($match[2] ?: ' ')));
        $limit = min($limit, max(0, $bytes - 65536));
    }
    return $limit;
}

function uvm_redact($value)
{
    global $uvm_secrets;
    if (is_array($value)) {
        $clean = [];
        foreach ($value as $key => $entry) {
            if (is_string($key) && preg_match('/token|password|secret|authorization/i', $key)) {
                $clean[$key] = '[redacted]';
            } else {
                $clean[$key] = uvm_redact($entry);
            }
        }
        return $clean;
    }
    if (!is_string($value)) return $value;
    foreach ($uvm_secrets as $secret) {
        if ($secret !== '') $value = str_replace($secret, '[redacted]', $value);
    }
    $value = preg_replace('~https?://[^\s/@]+:[^\s/@]+@~i', 'https://[redacted]@', $value);
    return preg_replace('/\b(?:glpat-|github_pat_|gh[pousr]_)[A-Za-z0-9_.-]+/', '[redacted]', $value);
}

function uvm_cli(string $action, array $payload = []): array
{
    $allowed = ['status', 'config-save', 'source-test', 'source-versions', 'source-download', 'source-upload-begin', 'source-upload-chunk', 'source-upload-finish', 'source-upload-cancel', 'upgrade-check', 'device-save', 'device-start', 'device-stop', 'device-remove'];
    if (!in_array($action, $allowed, true)) throw new InvalidArgumentException('Unsupported action');
    // Unraid may evaluate/cache .page templates outside their installed directory.
    $entrypoint = '/usr/local/emhttp/plugins/unraid-vgpu-manager/include/cli.php';
    if (!is_file($entrypoint) || !is_executable('/usr/bin/php')) {
        throw new RuntimeException('The plugin backend is not installed completely (include/cli.php or /usr/bin/php is missing).');
    }
    $input = json_encode($payload, JSON_THROW_ON_ERROR | JSON_INVALID_UTF8_SUBSTITUTE);
    if (strlen($input) > 131072) throw new InvalidArgumentException('The request exceeds 128 KiB.');
    $pipes = [];
    // argv array: no shell, and credentials are delivered only over stdin.
    $process = proc_open(['/usr/bin/php', $entrypoint, $action], [0 => ['pipe', 'r'], 1 => ['pipe', 'w'], 2 => ['pipe', 'w']], $pipes);
    if (!is_resource($process)) throw new RuntimeException('Unable to start the plugin backend.');
    foreach ($pipes as $pipe) stream_set_blocking($pipe, false);
    $timeout = $action === 'upgrade-check' ? 3600 : (in_array($action, ['source-download', 'source-upload-finish'], true) ? 900 : (str_starts_with($action, 'source-') ? 90 : 30));
    $deadline = microtime(true) + $timeout;
    $offset = 0;
    $output = '';
    $tooLarge = false;
    $expired = false;
    $status = ['running' => true, 'exitcode' => -1];
    while (true) {
        if (is_resource($pipes[0])) {
            if ($offset < strlen($input)) {
                $written = @fwrite($pipes[0], substr($input, $offset, 65536));
                if ($written !== false) $offset += $written;
            }
            if ($offset >= strlen($input)) fclose($pipes[0]);
        }
        $chunk = stream_get_contents($pipes[1]);
        if ($chunk !== false) {
            if (strlen($output) + strlen($chunk) > 2097152) $tooLarge = true;
            $output .= substr($chunk, 0, max(0, 2097152 - strlen($output)));
        }
        // Drain stderr to avoid a full pipe; never return raw stderr containing secrets.
        stream_get_contents($pipes[2]);
        $status = proc_get_status($process);
        if (!$status['running']) break;
        if (microtime(true) >= $deadline) {
            $expired = true;
            proc_terminate($process, 15);
            break;
        }
        usleep(20000);
    }
    $chunk = stream_get_contents($pipes[1]);
    if ($chunk !== false) {
        if (strlen($output) + strlen($chunk) > 2097152) $tooLarge = true;
        $output .= substr($chunk, 0, max(0, 2097152 - strlen($output)));
    }
    foreach ($pipes as $pipe) if (is_resource($pipe)) fclose($pipe);
    if ($expired) {
        // Do not wait forever on a kernel-stuck child or claim that an action was cancelled.
        throw new RuntimeException('The backend did not finish within its time limit. Completion is unknown; check status before retrying.');
    }
    $closed = proc_close($process);
    $exitCode = $status['exitcode'] >= 0 ? $status['exitcode'] : $closed;
    $result = json_decode($output, true);
    if ($tooLarge || !is_array($result) || !array_key_exists('ok', $result) || !is_bool($result['ok'])) {
        throw new RuntimeException('The backend returned an invalid response. Check the plugin installation and server logs.');
    }
    if (!$result['ok']) {
        $error = $result['error'] ?? $result['data']['error'] ?? $result['data']['message'] ?? 'The requested action failed.';
        throw new RuntimeException(is_string($error) ? uvm_redact($error) : 'The requested action failed.');
    }
    if ($exitCode !== 0) throw new RuntimeException('The backend exited with an error; the operation was not confirmed.');
    if (isset($result['data']) && !is_array($result['data'])) {
        throw new RuntimeException('The backend returned an invalid data object.');
    }
    return $result['data'] ?? [];
}

function uvm_csrf_token(): string
{
    global $var;
    // Unraid's native token is held in var.ini and usually exposed as $var by emhttp.
    $native = is_array($var ?? null) && is_string($var['csrf_token'] ?? null) ? $var['csrf_token'] : '';
    if ($native !== '') return $native;
    if (is_readable('/var/local/emhttp/var.ini')) {
        $variables = @parse_ini_file('/var/local/emhttp/var.ini', false, INI_SCANNER_RAW);
        if (is_array($variables) && is_string($variables['csrf_token'] ?? null)) return $variables['csrf_token'];
    }
    return '';
}

function uvm_origin_authority(string $url): string
{
    $parts = parse_url($url);
    if (!$parts || !in_array(strtolower($parts['scheme'] ?? ''), ['http', 'https'], true) || empty($parts['host']) || isset($parts['user']) || isset($parts['pass'])) return '';
    $scheme = strtolower($parts['scheme']);
    $port = $parts['port'] ?? ($scheme === 'https' ? 443 : 80);
    return $scheme . '://' . strtolower($parts['host']) . ':' . $port;
}

function uvm_check_post(string $expected): void
{
    // emhttp may consume csrf_token after its gateway check. Keep a separate
    // plugin field so this check works both before and after that processing.
    if ($expected === '' || !hash_equals($expected, uvm_post('uvm_csrf_token')) ||
        (array_key_exists('csrf_token', $_POST) && !hash_equals($expected, uvm_post('csrf_token')))) {
        throw new RuntimeException('页面校验失败，请重新打开插件设置页后再试。');
    }
    $fetchSite = strtolower((string)($_SERVER['HTTP_SEC_FETCH_SITE'] ?? ''));
    if (in_array($fetchSite, ['cross-site', 'same-site'], true)) throw new RuntimeException('Cross-origin requests are not allowed.');
    $scheme = (!empty($_SERVER['HTTPS']) && strtolower((string)$_SERVER['HTTPS']) !== 'off') || (string)($_SERVER['SERVER_PORT'] ?? '') === '443' ? 'https' : 'http';
    $host = (string)($_SERVER['HTTP_HOST'] ?? '');
    $local = uvm_origin_authority($scheme . '://' . $host);
    $origin = (string)($_SERVER['HTTP_ORIGIN'] ?? '');
    $referrer = (string)($_SERVER['HTTP_REFERER'] ?? '');
    if ($local === '' || ($origin !== '' ? uvm_origin_authority($origin) !== $local : ($referrer === '' || uvm_origin_authority($referrer) !== $local))) {
        throw new RuntimeException('The request origin does not match this Unraid web interface. Open the page using the same server URL.');
    }
}

function uvm_form_hidden(string $action, string $csrf, array $fields = []): void
{
    echo '<input type="hidden" name="uvm_action" value="' . uvm_h($action) . '">';
    echo '<input type="hidden" name="csrf_token" value="' . uvm_h($csrf) . '">';
    echo '<input type="hidden" name="uvm_csrf_token" value="' . uvm_h($csrf) . '">';
    foreach ($fields as $name => $value) echo '<input type="hidden" name="' . uvm_h($name) . '" value="' . uvm_h($value) . '">';
}

function uvm_profile_scan(): array
{
    $gpus = [];
    foreach (glob('/sys/bus/pci/devices/*') ?: [] as $directory) {
        if (uvm_read($directory . '/vendor') !== '0x10de' || !str_starts_with(uvm_read($directory . '/class'), '0x03')) continue;
        $pci = basename($directory);
        if (!preg_match('/^[0-9a-f]{4}:[0-9a-f]{2}:[0-9a-f]{2}\.[0-7]$/D', $pci)) continue;
        $profiles = [];
        foreach (glob($directory . '/mdev_supported_types/*') ?: [] as $typeDirectory) {
            $type = basename($typeDirectory);
            if (!preg_match('/^nvidia-[0-9]+$/D', $type)) continue;
            $info = [];
            foreach (preg_split('/,\s*/', uvm_read($typeDirectory . '/description')) as $item) {
                $pair = explode('=', $item, 2);
                if (count($pair) === 2) $info[trim($pair[0])] = trim($pair[1]);
            }
            $profiles[] = [
                'type' => $type, 'name' => uvm_read($typeDirectory . '/name'),
                'available' => uvm_read($typeDirectory . '/available_instances'),
                'framebuffer' => $info['framebuffer'] ?? '', 'heads' => $info['num_heads'] ?? '',
                'resolution' => $info['max_resolution'] ?? '', 'frl' => $info['frl_config'] ?? '',
                'maximum' => $info['max_instance'] ?? '',
            ];
        }
        usort($profiles, static fn($left, $right) => strnatcmp($left['name'], $right['name']));
        $gpus[$pci] = ['device' => uvm_read($directory . '/device'), 'profiles' => $profiles];
    }
    return $gpus;
}

$uvm_secrets = [];
$uvm_csrf = uvm_csrf_token();
$uvm_message = '';
$uvm_error = '';
$uvm_action_data = null;
$uvm_versions = [];
$uvm_action = '';
$uvm_upload_request = is_string($_POST['uvm_action'] ?? null) && in_array($_POST['uvm_action'], ['source-upload-begin', 'source-upload-chunk', 'source-upload-finish', 'source-upload-cancel'], true);
if (($_SERVER['REQUEST_METHOD'] ?? 'GET') === 'POST') {
    try {
        uvm_check_post($uvm_csrf);
        $uvm_action = uvm_post('uvm_action');
        $payload = [];
        switch ($uvm_action) {
            case 'config-save':
                $source = [];
                foreach (['provider', 'mode', 'repository', 'driver', 'tag_template', 'project_id', 'package_name', 'package_version_template'] as $key) $source[$key] = trim(uvm_post('source_' . $key));
                if (isset($_POST['source_url'])) $source['url'] = trim(uvm_post('source_url'));
                if (uvm_post('source_simple') === '1' && ($source['url'] ?? '') === '') $source['repository'] = '';
                $payload = [
                    'source' => $source,
                    'runtime' => [
                        'enabled' => uvm_post('runtime_enabled') === '1',
                        'unlock' => uvm_post('runtime_unlock') === '1',
                        'unlock_library' => trim(uvm_post('runtime_unlock_library')),
                        'xml_override' => uvm_post('runtime_xml_override') === '1',
                    ],
                ];
                if (isset($_POST['upgrade_enabled'])) $payload['upgrade'] = ['enabled' => uvm_post('upgrade_enabled') === '1'];
                $credentialChange = uvm_post('credential_change', 'auto');
                if ($credentialChange === 'auto') $credentialChange = uvm_post('credential_token') !== '' ? 'replace' : 'keep';
                if ($credentialChange === 'replace') {
                    $token = uvm_post('credential_token');
                    if ($token === '') throw new InvalidArgumentException('To replace credentials, enter a token. Choose “keep” or “remove” otherwise.');
                    $uvm_secrets[] = $token;
                    $payload['credential'] = ['type' => uvm_post('credential_type', 'auto'), 'token' => $token, 'username' => trim(uvm_post('credential_username'))];
                } elseif ($credentialChange === 'remove') {
                    $payload['credential'] = ['type' => 'none', 'token' => '', 'username' => ''];
                } elseif ($credentialChange !== 'keep') {
                    throw new InvalidArgumentException('Invalid credential operation.');
                }
                if (uvm_post('override_replace') === '1') {
                    $overrideContent = str_replace("\r", '', uvm_post('override_content'));
                    if (strlen($overrideContent) > 65536) throw new InvalidArgumentException('profile_override.toml must not exceed 64 KiB.');
                    $payload['override_content'] = $overrideContent;
                }
                $uvm_action_data = uvm_cli($uvm_action, $payload);
                $uvm_message = '设置已保存。';
                if (isset($uvm_action_data['upgrade_helper']) && !($uvm_action_data['upgrade_helper']['ok'] ?? false)) {
                    $uvm_error = '设置已保存，但升级助手未启动，请检查插件安装。';
                }
                if (uvm_post('source_connect') === '1') {
                    $uvm_action_data = uvm_cli('source-versions');
                    $uvm_versions = is_array($uvm_action_data['versions'] ?? null) ? $uvm_action_data['versions'] : [];
                    $uvm_message = count($uvm_versions) ? '已找到 ' . count($uvm_versions) . ' 个匹配当前内核的驱动版本。' : '未找到匹配当前内核的驱动。';
                }
                break;
            case 'upgrade-check':
                $uvm_action_data = uvm_cli($uvm_action, ['force' => true]);
                $upgradeCode = (string)($uvm_action_data['status'] ?? '');
                $uvm_message = $upgradeCode === 'ready' ? '目标内核的驱动已准备好。' : '升级准备检查完成，请查看系统升级状态。';
                break;
            case 'source-test':
            case 'source-versions':
            case 'source-download':
                // Only saved source + saved credentials are used. No implicit config-save.
                if ($uvm_action === 'source-download' && uvm_post('download_driver') !== '') $payload['driver'] = trim(uvm_post('download_driver'));
                $uvm_action_data = uvm_cli($uvm_action, $payload);
                if (($uvm_action_data['ok'] ?? true) === false) throw new RuntimeException((string)($uvm_action_data['error'] ?? $uvm_action_data['message'] ?? 'The source operation failed.'));
                if ($uvm_action === 'source-versions') {
                    $uvm_versions = is_array($uvm_action_data['versions'] ?? null) ? $uvm_action_data['versions'] : [];
                    $uvm_message = count($uvm_versions) ? '已找到 ' . count($uvm_versions) . ' 个匹配版本。' : '未找到匹配当前内核的驱动。';
                } elseif ($uvm_action === 'source-download') {
                    $uvm_message = '驱动已下载并校验，文件已保存到缓存。';
                } else {
                    $uvm_message = '连接成功。';
                }
                break;
            case 'source-upload-begin':
                $total = uvm_post('total');
                if (!preg_match('/^[1-9][0-9]*$/D', $total) || strlen($total) > 10) throw new InvalidArgumentException('文件大小无效。');
                $uvm_action_data = uvm_cli($uvm_action, ['filename' => uvm_post('filename'), 'total' => (int)$total, 'checksum' => uvm_post('checksum')]);
                break;
            case 'source-upload-chunk':
                $chunk = $_FILES['chunk'] ?? null;
                if (!is_array($chunk) || ($chunk['error'] ?? UPLOAD_ERR_NO_FILE) !== UPLOAD_ERR_OK || !is_string($chunk['tmp_name'] ?? null) || !is_uploaded_file($chunk['tmp_name'])) {
                    throw new InvalidArgumentException('上传分块失败，请检查服务器上传限制。');
                }
                $offset = uvm_post('offset');
                if (!preg_match('/^(0|[1-9][0-9]*)$/D', $offset) || strlen($offset) > 10) throw new InvalidArgumentException('上传位置无效。');
                $uvm_action_data = uvm_cli($uvm_action, ['upload_id' => uvm_post('upload_id'), 'offset' => (int)$offset, 'path' => $chunk['tmp_name']]);
                break;
            case 'source-upload-finish':
            case 'source-upload-cancel':
                $uvm_action_data = uvm_cli($uvm_action, ['upload_id' => uvm_post('upload_id')]);
                break;
            case 'device-save':
                foreach (['uuid', 'pci', 'profile', 'type'] as $key) $payload[$key] = trim(uvm_post($key));
                $uvm_action_data = uvm_cli($uvm_action, $payload);
                $uvm_message = '设备配置已保存。';
                break;
            case 'device-start':
            case 'device-stop':
            case 'device-remove':
                $uvm_action_data = uvm_cli($uvm_action, ['uuid' => trim(uvm_post('uuid'))]);
                $uvm_message = ['device-start' => '设备已启动。', 'device-stop' => '设备已停止。', 'device-remove' => '设备配置已移除。'][$uvm_action];
                break;
            default:
                throw new InvalidArgumentException('Unsupported page action.');
        }
    } catch (Throwable $exception) {
        $uvm_error = uvm_redact($exception->getMessage());
        $uvm_message = '';
    }
}

// Unraid wraps .page responses in its own HTML. A small tagged response works
// with that wrapper without a second public endpoint or filesystem writer.
if ($uvm_upload_request) {
    echo '<script type="application/json" id="uvm-upload-result">' . uvm_json($uvm_error === '' ? ['ok' => true, 'data' => $uvm_action_data] : ['ok' => false, 'error' => $uvm_error]) . '</script>';
    return;
}

$uvm_status = [];
$uvm_status_ok = false;
try {
    $uvm_status = uvm_cli('status');
    $uvm_status_ok = true;
} catch (Throwable $exception) {
    $uvm_error .= ($uvm_error !== '' ? "\n" : '') . '状态读取失败：' . uvm_redact($exception->getMessage());
}
$uvm_defaults = [
    'source' => ['url' => '', 'provider' => 'auto', 'mode' => 'auto', 'repository' => '', 'driver' => '', 'project_id' => '', 'tag_template' => 'v{kernel}-{driver}', 'package_name' => 'build', 'package_version_template' => 'v{kernel}-{driver}'],
    'runtime' => ['enabled' => false, 'unlock' => true, 'unlock_library' => '/usr/lib64/libvgpu_unlock_rs.so', 'xml_override' => false],
    'upgrade' => ['enabled' => false, 'driver_branch' => '', 'enabled_boot_id' => ''],
];
$uvm_settings = array_replace_recursive($uvm_defaults, is_array($uvm_status['settings'] ?? null) ? $uvm_status['settings'] : []);
$uvm_source = $uvm_settings['source'];
$uvm_runtime_settings = $uvm_settings['runtime'];
$uvm_upgrade = is_array($uvm_status['upgrade'] ?? null) ? $uvm_status['upgrade'] : [];
$uvm_installation = is_array($uvm_status['driver_installation'] ?? null) ? $uvm_status['driver_installation'] : [];
$uvm_devices = is_array($uvm_status['devices'] ?? null) ? $uvm_status['devices'] : [];
$uvm_runtime = is_array($uvm_status['runtime'] ?? null) ? $uvm_status['runtime'] : [];
$uvm_pending = !empty($uvm_status['pending_restart']) || !empty($uvm_settings['pending_restart']);
$uvm_controls = $uvm_status_ok && $uvm_csrf !== '';
$uvm_gpus = uvm_profile_scan();
$uvm_selected_package = $uvm_settings['selected_package'] ?? null;
$uvm_override = is_string($uvm_status['override_content'] ?? null) ? $uvm_status['override_content'] : '';
$uvm_uuid_bytes = random_bytes(16);
$uvm_uuid_bytes[6] = chr((ord($uvm_uuid_bytes[6]) & 15) | 64);
$uvm_uuid_bytes[8] = chr((ord($uvm_uuid_bytes[8]) & 63) | 128);
$uvm_uuid_hex = bin2hex($uvm_uuid_bytes);
$uvm_new_uuid = substr($uvm_uuid_hex, 0, 8) . '-' . substr($uvm_uuid_hex, 8, 4) . '-' . substr($uvm_uuid_hex, 12, 4) . '-' . substr($uvm_uuid_hex, 16, 4) . '-' . substr($uvm_uuid_hex, 20);
?>
